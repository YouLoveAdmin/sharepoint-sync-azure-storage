# Main sites: sync configured libraries, plus navigation when enabled.
SHAREPOINT_SITE_URLS=https://contoso.sharepoint.com/sites/example;https://contoso.sharepoint.com/sites/example2
SHAREPOINT_LIBRARY_NAMES=Shared Documents;Site Pages
SHAREPOINT_INCLUDE_NAVIGATION=false
SHAREPOINT_NAVIGATION_LOCATIONS=Auto
# Additional navigation-only sites; merged into OUTPUT_DIR/Extended_Knowledge.md.
SHAREPOINT_SITE_URLS_NAVIGATION=https://contoso.sharepoint.com/sites/example3;https://contoso.sharepoint.com/sites/example4
# Individual page URLs only: no document-library or navigation export for these sites.
SHAREPOINT_SITE_PAGES=https://contoso.sharepoint.com/sites/example5/SitePages/page1.aspx;https://contoso.sharepoint.com/sites/example6/SitePages/page2.aspx

# The converter must support multipart POST /convert (field: file) and return
# a JSON download_url hosted on the same origin.
MARKITDOWN_API_URL=http://127.0.0.1:5001
# Source extension allowlist (case-insensitive; semicolons or commas).
# Empty/unset disables filtering. Include .ASPX for Site Pages; HTML conversion
# does not change the source extension used by the filter.
SUPPORTED_SOURCE_FILE_TYPES=.DOC;.DOCX;.PDF;.MD;.TXT;.XLS;.XLSX;.PPT;.PPTX;.HTML;.HTM;.ASP;.CSV;.ASPX;.JSON;.XML

# Required destination for BOTH Markdown and .sync-state.json (delta cursors,
# ETags/item mappings, and run history). There is no separate local state cache.
# Azure destination below is under the /output mount. For local development,
# override it with ./output/upstream/workspace-in-sync.
OUTPUT_DIR=/output/upstream/workspace-in-sync

# Optional client ID when using a user-assigned managed identity.
AZURE_CLIENT_ID=
MAX_UPLOAD_BYTES=104857600
# Actual Linux cron in the Docker image checks once per minute. When enabled,
# sync runs immediately at startup, then when this interval (seconds) is due.
# Unset AUTO_SYNC defaults to false; SYNC_INTERVAL defaults to 43200 (12h).
AUTO_SYNC=true
SYNC_INTERVAL=43200

# One-time deployment configuration.
# Optional: when set, verifies the Azure CLI tenant; otherwise uses its selected tenant.
AZURE_TENANT_ID=
# Optional: otherwise uses the current Azure CLI subscription.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=Canada Central
AZURE_CONTAINER_APP_NAME=
AZURE_CONTAINER_APPS_ENVIRONMENT=
AZURE_CONTAINER_IMAGE=ghcr.io/youloveadmin/sharepoint-sync-azure-storage:latest
# Set BOTH account and share to reuse existing SMB storage in the selected
# subscription. Neither resource is created or modified.
# Leave BOTH blank to create dedicated storage (legacy/default behavior).
AZURE_PERSISTENT_FILE_SHARE=
# Container volume name. Existing account/share mounts get a stable derived
# environment storage registration name; previous registrations are preserved.
AZURE_PERSISTENT_VOLUME_NAME=sharepoint-output
AZURE_PERSISTENT_STORAGE_ACCOUNT=
# Optional: existing account's resource group; blank uses AZURE_RESOURCE_GROUP.
# This does not change the Container App resource group.
AZURE_PERSISTENT_STORAGE_ACCOUNT_RESOURCE_GROUP=
# Share root mounts here; OUTPUT_DIR must equal this path or be below it.
AZURE_PERSISTENT_VOLUME_MOUNT_PATH=/output

# Scheduled-job deployment (alternative to the continuously running API).
# Defaults to <AZURE_CONTAINER_APP_NAME>-job when blank.
AZURE_CONTAINER_JOB_NAME=
# Must be a USER-assigned identity resource ID, not the Container App resource ID.
# Grant this identity Graph + SharePoint Sites.Selected and site-level read first.
AZURE_JOB_IDENTITY_RESOURCE_ID=
# Five-field UTC cron. Jobs ignore AUTO_SYNC and SYNC_INTERVAL.
AZURE_JOB_CRON=0 */12 * * *